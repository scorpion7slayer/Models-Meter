<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="26dp" android:gravity="center_vertical" android:orientation="horizontal"
    android:paddingVertical="2dp">
    <ImageView android:id="@+id/model_row_icon" android:layout_width="18dp" android:layout_height="18dp"
        android:layout_marginEnd="10dp" android:src="@drawable/ic_models_meter" android:importantForAccessibility="no" />
    <TextView android:id="@+id/model_row_name" android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="wrap_content" android:fontFamily="sec" android:textSize="14sp" android:textStyle="bold"
        android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false"
        android:textColor="@color/models_widget_foreground" />
</LinearLayout>
